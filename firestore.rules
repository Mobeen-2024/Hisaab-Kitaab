rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // We only need basic ownership validation for all per-user collections
    match /users/{userId} {
      match /transactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.context in ['personal', 'business']
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10;
      }
      match /customers/{customerId} {
        allow read, write: if isOwner(userId);
      }
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }
      match /inventory/{inventoryId} {
        allow read, write: if isOwner(userId);
      }
      match /appUsers/{appUserId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && !('passcodeHash' in request.resource.data)
          && !('passcodeSalt' in request.resource.data)
          && !('passcode' in request.resource.data);
      }
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /udhaarEntries/{udhaarId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['give', 'receive'];
      }
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }
      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }
      match /messages/{messageId} {
        allow read, write: if isOwner(userId);
      }
      match /auditLogs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
